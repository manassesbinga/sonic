# Sonic configuration via environment variables
# These override values in sonic.yaml
#
# Usage: source .env && sonic start

# Network
SONIC_LISTEN_PORT=8443
# SONIC_TARGET_PORTS=80,443,8080

# Mode: intercept | passthrough-all | observe
SONIC_MODE=intercept

# TLS
SONIC_TLS_CA_DIR=./certs
SONIC_TLS_AUTO_GENERATE=true

# Runtime
SONIC_RUNTIME_TIMEOUT_MS=50
SONIC_RUNTIME_POOL_SIZE=64
# failsafe: bypass | block
SONIC_RUNTIME_FAILSAFE=bypass

# Bypass domains (comma-separated)
# SONIC_BYPASS_DOMAINS=*.stripe.com,*.amazonaws.com

# Logging
SONIC_LOG_LEVEL=info
SONIC_LOG_FORMAT=text
